{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "research-report-v1"
        },
        "profile_id": {
          "type": "string",
          "const": "alpha-orchestrator"
        },
        "symbol": {
          "type": "string",
          "const": "NVDA"
        },
        "data_mode": {
          "type": "string",
          "enum": [
            "LIVE_RESEARCH",
            "REPLAY",
            "DEMO"
          ]
        },
        "as_of": {
          "type": "string",
          "maxLength": 64,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "risks": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "status": {
          "type": "string",
          "const": "DRAFT_READY"
        },
        "evidence": {
          "minItems": 2,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool_call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tool": {
                "type": "string",
                "enum": [
                  "market_snapshot",
                  "indicators"
                ]
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "data_snapshot_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "available_at": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "tool_call_id",
              "tool",
              "source_id",
              "data_snapshot_hash",
              "available_at"
            ],
            "additionalProperties": false
          }
        },
        "draft_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "symbol",
        "data_mode",
        "as_of",
        "summary",
        "risks",
        "status",
        "evidence",
        "draft_id"
      ],
      "additionalProperties": false
    },
