{
  "schema_version": 1,
  "description": "BFF request input schemas. Zod remains authoritative for normalization and cross-field refinements; this is not a complete OpenAPI document.",
  "schemas": {
    "trainingEvidenceQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^training-evidence-[a-f0-9]{64}$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-4][0-9]|50)$"
        }
      },
      "additionalProperties": false
    },
    "backtestQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^backtest-report-[a-f0-9]{64}$"
        },
        "model_id": {
          "type": "string",
          "pattern": "^lightgbm-experimental-[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-4][0-9]|50)$"
        }
      },
      "additionalProperties": false
    },
    "resourceIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "stockSymbolSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "maxLength": 32,
      "pattern": "^[ \\t\\r\\n]*[Nn][Vv][Dd][Aa][ \\t\\r\\n]*$"
    },
    "idempotencyKeySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "emptyRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "loginRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "email",
        "password"
      ],
      "additionalProperties": false
    },
    "pageQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"
        }
      },
      "additionalProperties": false
    },
    "predictionQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"
        },
        "status": {
          "type": "string",
          "enum": [
            "FROZEN",
            "SETTLED",
            "UNSCORABLE",
            "WAITING_DATA",
            "SETTLEMENT_FAILED"
          ]
        }
      },
      "additionalProperties": false
    },
    "messageQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "default": "0",
          "type": "string",
          "pattern": "^\\d{1,18}$"
        }
      },
      "additionalProperties": false
    },
    "eventQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "additionalProperties": false
    },
    "createSessionSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "profile_id": {
          "default": "alpha-orchestrator",
          "type": "string",
          "const": "alpha-orchestrator"
        }
      },
      "additionalProperties": false
    },
    "sendMessageSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "text",
        "request_id"
      ],
      "additionalProperties": false
    },
    "freezeRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "draft_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "confirmed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "draft_id",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "qualityGateIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^model-quality-gate-[a-f0-9]{64}$"
    },
    "qualityGateRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "price_assessment_id": {
          "type": "string",
          "pattern": "^historical-quality-assessment-[a-f0-9]{64}$"
        },
        "probability_assessment_id": {
          "type": "string",
          "pattern": "^probability-quality-assessment-[a-f0-9]{64}$"
        }
      },
      "required": [
        "proposal_id",
        "price_assessment_id",
        "probability_assessment_id"
      ],
      "additionalProperties": false
    },
    "probabilityPolicyQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^probability-quality-policy-[a-f0-9]{64}$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-4][0-9]|50)$"
        },
        "horizon_sessions": {
          "type": "string",
          "enum": [
            "1",
            "3",
            "5",
            "10",
            "20"
          ]
        }
      },
      "additionalProperties": false
    },
    "probabilityPolicyIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^probability-quality-policy-[a-f0-9]{64}$"
    },
    "probabilityAssessmentIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^probability-quality-assessment-[a-f0-9]{64}$"
    },
    "probabilityAssessmentRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^probability-quality-policy-[a-f0-9]{64}$"
        },
        "calibration_id": {
          "type": "string",
          "pattern": "^calibration-experimental-[a-f0-9]{64}$"
        }
      },
      "required": [
        "policy_id",
        "calibration_id"
      ],
      "additionalProperties": false
    },
    "experimentalCalibrationIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^calibration-experimental-[a-f0-9]{64}$"
    },
    "modelReviewSubmissionSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "proposal_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "assessment_id": {
              "type": "string",
              "pattern": "^historical-quality-assessment-[a-f0-9]{64}$"
            },
            "action": {
              "type": "string",
              "enum": [
                "APPROVE",
                "REJECT"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expected_previous_review_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "proposal_id",
            "assessment_id",
            "action",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "proposal_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "action": {
              "type": "string",
              "enum": [
                "APPROVE",
                "REJECT"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expected_previous_review_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "quality_gate_id": {
              "type": "string",
              "pattern": "^model-quality-gate-[a-f0-9]{64}$"
            }
          },
          "required": [
            "proposal_id",
            "action",
            "reason",
            "quality_gate_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "qualityPolicyQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^historical-quality-policy-[a-f0-9]{64}$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-4][0-9]|50)$"
        },
        "horizon_sessions": {
          "type": "string",
          "enum": [
            "1",
            "3",
            "5",
            "10",
            "20"
          ]
        }
      },
      "additionalProperties": false
    },
    "qualityPolicyIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^historical-quality-policy-[a-f0-9]{64}$"
    },
    "qualityAssessmentIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^historical-quality-assessment-[a-f0-9]{64}$"
    },
    "qualityAssessmentRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^historical-quality-policy-[a-f0-9]{64}$"
        },
        "candidate_evaluation_id": {
          "type": "string",
          "pattern": "^model-evaluation-experimental-[a-f0-9]{64}$"
        },
        "reference_evaluation_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^model-evaluation-experimental-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policy_id",
        "candidate_evaluation_id"
      ],
      "additionalProperties": false
    },
    "modelProposalQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-4][0-9]|50)$"
        }
      },
      "additionalProperties": false
    },
    "modelProposalKeySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "modelProposalRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "candidate_evaluation_id": {
          "type": "string",
          "pattern": "^model-evaluation-experimental-[a-f0-9]{64}$"
        },
        "reference_evaluation_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^model-evaluation-experimental-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "candidate_evaluation_id",
        "rationale"
      ],
      "additionalProperties": false
    },
    "experimentalComparisonRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "evaluation_ids": {
          "minItems": 2,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^model-evaluation-experimental-[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "evaluation_ids"
      ],
      "additionalProperties": false
    },
    "evaluationRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "base_from": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "base_to": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "cutoff": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "base_from",
        "base_to",
        "cutoff"
      ],
      "additionalProperties": false
    },
    "experimentalEvaluationQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^model-evaluation-experimental-[a-f0-9]{64}$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-4][0-9]|50)$"
        }
      },
      "additionalProperties": false
    },
    "experimentalEvaluationIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^model-evaluation-experimental-[a-f0-9]{64}$"
    },
    "experimentalModelIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "pattern": "^lightgbm-experimental-[a-f0-9]{64}$"
    },
    "experimentalModelQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^lightgbm-experimental-[a-f0-9]{64}$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-4][0-9]|50)$"
        },
        "horizon_sessions": {
          "type": "string",
          "enum": [
            "1",
            "3",
            "5",
            "10",
            "20"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
