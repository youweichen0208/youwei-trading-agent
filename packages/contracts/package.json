{
  "name": "@yta/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./bff.openapi.json": "./bff.openapi.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "requests:export": "pnpm build && node scripts/export-requests.mjs",
    "requests:check": "pnpm build && node scripts/export-requests.mjs --check",
    "bff:export": "pnpm requests:export && node scripts/export-bff-openapi.mjs",
    "bff:check": "pnpm requests:check && node scripts/export-bff-openapi.mjs --check",
    "report:export": "pnpm build && node scripts/export-report.mjs",
    "report:check": "pnpm build && node scripts/export-report.mjs --check"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "files": [
    "dist",
    "bff.openapi.json"
  ]
}
