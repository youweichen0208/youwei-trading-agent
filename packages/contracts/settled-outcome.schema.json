{
  "$defs": {
    "Direction": {
      "enum": [
        "UP",
        "DOWN",
        "FLAT"
      ],
      "title": "Direction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "SETTLED",
      "default": "SETTLED",
      "title": "Status",
      "type": "string"
    },
    "actual_return": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Actual Return"
    },
    "actual_direction": {
      "$ref": "#/$defs/Direction"
    },
    "absolute_error": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Absolute Error"
    },
    "zero_return_absolute_error": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Zero Return Absolute Error"
    },
    "direction_correct": {
      "title": "Direction Correct",
      "type": "boolean"
    },
    "base_close": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Base Close"
    },
    "target_close": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Target Close"
    },
    "split_factor": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Split Factor"
    },
    "frozen_base_close": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Frozen Base Close"
    },
    "base_price_difference": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Base Price Difference"
    },
    "base_revision": {
      "title": "Base Revision",
      "type": "string"
    },
    "base_revision_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Revision Snapshot Hash"
    },
    "base_revision_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Revision Provider"
    },
    "base_revision_source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Revision Source Id"
    },
    "base_revision_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Revision As Of"
    },
    "calculation_version": {
      "default": "settlement-price-v1",
      "enum": [
        "settlement-price-v1",
        "settlement-price-v2"
      ],
      "title": "Calculation Version",
      "type": "string"
    },
    "data_snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Data Snapshot Hash",
      "type": "string"
    },
    "source_revision": {
      "title": "Source Revision",
      "type": "string"
    }
  },
  "required": [
    "actual_return",
    "actual_direction",
    "absolute_error",
    "zero_return_absolute_error",
    "direction_correct",
    "base_close",
    "target_close",
    "split_factor",
    "frozen_base_close",
    "base_price_difference",
    "base_revision",
    "data_snapshot_hash",
    "source_revision"
  ],
  "title": "Outcome",
  "type": "object"
}
