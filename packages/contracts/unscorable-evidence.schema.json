{
  "$defs": {
    "DataMode": {
      "enum": [
        "LIVE_RESEARCH",
        "REPLAY",
        "DEMO"
      ],
      "title": "DataMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "const": "NVDA",
      "default": "NVDA",
      "title": "Symbol",
      "type": "string"
    },
    "data_mode": {
      "$ref": "#/$defs/DataMode"
    },
    "target_session": {
      "format": "date",
      "title": "Target Session",
      "type": "string"
    },
    "reason": {
      "enum": [
        "TARGET_HALTED_NO_CLOSE",
        "DELISTED_NO_PRICE",
        "UNRESOLVED_CORPORATE_ACTION"
      ],
      "title": "Reason",
      "type": "string"
    },
    "provider": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "source_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_document_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Document Sha256",
      "type": "string"
    },
    "statement": {
      "maxLength": 10000,
      "minLength": 20,
      "title": "Statement",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    }
  },
  "required": [
    "data_mode",
    "target_session",
    "reason",
    "provider",
    "source_id",
    "source_document_sha256",
    "statement",
    "published_at",
    "available_at",
    "retrieved_at"
  ],
  "title": "UnscorableEvidence",
  "type": "object"
}
