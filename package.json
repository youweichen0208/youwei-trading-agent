{
  "name": "hermes-alpha-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "tsx --test tests/server/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:access": "tsx scripts/provision-database-access.ts",
    "dev": "next dev apps/web --webpack -p 3400",
    "build": "next build apps/web --webpack",
    "start": "next start apps/web -p 3400",
    "worker": "tsx apps/worker/main.ts",
    "tools": "tsx apps/tools/main.ts",
    "hermes:catalog": "tsx scripts/export-hermes-tools.ts",
    "hermes:prepare": "tsx scripts/prepare-profiles.ts",
    "hermes:supervise": "tsx scripts/supervise-profiles.ts",
    "hermes:reconcile": "tsx scripts/reconcile-profile.ts",
    "hermes:prepare-auto": "tsx scripts/prepare-profiles-auto.ts",
    "hermes:rotate-model": "tsx scripts/rotate-model.ts",
    "feishu": "tsx apps/feishu/main.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "lightweight-charts": "5.2.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
