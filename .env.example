# Local development only. Copy to .env; never use these sample credentials in a deployment.
YTA_ENV=development
YTA_DATA_MODE=REPLAY
YTA_DATABASE_URL=postgresql://yta_app:local-yta-app@127.0.0.1:54329/yta
YTA_MIGRATION_DATABASE_URL=postgresql://yta_owner:local-yta-owner@127.0.0.1:54329/yta
YTA_TEST_DATABASE_URL=postgresql://yta_owner:local-yta-owner@127.0.0.1:54329/yta_test
YTA_ALPHA_TOKEN=replace-with-at-least-32-random-characters
YTA_ALPHA_URL=http://127.0.0.1:8100
# LIVE_RESEARCH must use verified providers; no fixture fallback.
# YTA_HERMES_URL=
# YTA_HERMES_KEY=
# YTA_MARKET_PROVIDER=
# YTA_MARKET_API_KEY=

# Optional private finance-tool credential. Generate independently from YTA_ALPHA_TOKEN.
# Leave unset until the tool bridge is configured; do not set it to an empty string.
# YTA_ALPHA_TOOLS_TOKEN=replace-with-a-distinct-random-token-of-at-least-32-characters

# Per authenticated owner and data mode; rolling 24 hours, including failed/cancelled runs.
YTA_RESEARCH_RUNS_PER_24H=50

# Optional explicit OTLP/HTTP collector endpoint; omit to disable tracing.
# YTA_OTLP_TRACES_URL=http://127.0.0.1:4318/v1/traces
# Optional finance-tool tracing (separate process, YTA_TOOLS_ prefix).
# YTA_TOOLS_OTLP_TRACES_URL=http://127.0.0.1:4318/v1/traces
# YTA_TOOLS_ENV=development

# BFF business-write admission only. Existing runs, Jobs, auth and cancellation are separate.
YTA_WRITE_ADMISSION=OPEN

# Settlement Jobs only; does not cancel an in-flight settlement or pause BFF writes.
YTA_JOBS_DISPATCH=OPEN

# Optional experimental inference; requires the training-runtime image target.
YTA_EXPERIMENTAL_MODELS=DISABLED
# Optional server-managed reviewer UUIDs, comma-separated. Empty grants nobody access.
# Permission alone never qualifies evidence or approves a model.
YTA_MODEL_REVIEWER_IDS=
