# Local development only. Production must use separate migration/runtime credentials.
DATABASE_URL=postgresql://alpha:local-development-only@127.0.0.1:55439/alpha_test
TEST_DATABASE_URL=postgresql://alpha:local-development-only@127.0.0.1:55439/alpha_test

APP_ORIGIN=http://localhost:3400

# Server-only path to verified per-profile bindings; unset means no runtime is connected.
# HERMES_PROFILE_REGISTRY=/absolute/private/path/profiles.json

# Optional trusted Market adapter loaded by the private tool gateway.
# MARKET_PROVIDER=alpaca
# ALPACA_DATA_KEY=configure-on-server
# ALPACA_DATA_SECRET=configure-on-server
# ALPACA_DATA_FEED=iex
# QUANT_PYTHON=/absolute/path/to/project/.venv/bin/python
# QUANT_PROJECT_ROOT=/absolute/path/to/project

# Worker-only encryption key for execution-scoped tool capabilities (64 hex characters).
# TOOL_CAPABILITY_KEY=generate-and-store-a-private-random-32-byte-key
# Private gateway; never expose it as a browser-facing endpoint.
TOOL_GATEWAY_HOST=127.0.0.1
TOOL_GATEWAY_PORT=3410

# Continuous research runs in the existing Worker. Configure sources in BOTH
# Worker and Tools; the Web needs the same presence flags for source status.
# SEC_USER_AGENT=Your research agent contact@example.com
# BRAVE_SEARCH_API_KEY=configure-on-server
# X_BEARER_TOKEN=configure-on-server
# FRED_API_KEY=configure-on-server
# ALPACA_ASSET_API_ORIGIN=https://paper-api.alpaca.markets
# FORECAST_MODEL_VERSION=your-pinned-model-and-prompt-version
# Agent settings (/lab) default to 30 background stocks/day, <=10 new candidates,
# 5/20-session forecasts and 08:00 Asia/Shanghai digest. No credentials go in UI.
