{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/server/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/tools/**/*.ts",
    "apps/feishu/**/*.ts"
  ]
}
